<section id="afk-ready-check" class="afk-ready-check">
  <div class="arc-actions flexrow">
    <button type="button" data-action="ready" class="arc-ready-button">
      <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
      <span>Ready!</span>
    </button>
    <button type="button" data-action="afk" class="arc-afk-button">
      <i class="fa-solid fa-circle-xmark" aria-hidden="true"></i>
      <span>AFK</span>
      <span class="arc-countdown" data-countdown {{#unless countdownVisible}}hidden{{/unless}}>
        {{countDownCounter}}
      </span>
    </button>
  </div>

  <ol class="arc-player-list">
    {{#each playerStatuses}}
      <li class="arc-player-status {{cssClass}}" data-user-id="{{userId}}">
        <span class="arc-player-name">{{name}}</span>
        <span class="arc-player-state" title="{{title}}">
          <i class="{{iconClass}}" aria-hidden="true"></i>
          <span>{{label}}</span>
        </span>
      </li>
    {{else}}
      <li class="arc-player-status arc-empty">
        <span>No player users found.</span>
      </li>
    {{/each}}
  </ol>
</section>
